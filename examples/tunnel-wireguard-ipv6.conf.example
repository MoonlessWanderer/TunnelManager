# IPv6 WireGuard tunnel. AllowedIPs is the peer host /128, never ::/0.
TM_TUNNEL_NAME=edge6
TM_TUNNEL_TYPE=wireguard
TM_TUNNEL_STATE=active
TM_LOCAL_PUBLIC_IP=2001:db8::10
TM_REMOTE_PUBLIC_IP=2001:db8::20
TM_LOCAL_TUNNEL_IP=2001:db8:1::1
TM_REMOTE_TUNNEL_IP=2001:db8:1::2
TM_TUNNEL_CIDR=64
TM_LISTEN_PORT=51820
TM_ENDPOINT_PORT=51820
TM_MTU=1400
TM_KEEPALIVE=25
TM_WAN_IFACE=eth0
TM_PEER_PUBLIC_KEY=BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB=
TM_PRIVATE_KEY_FILE=/etc/tunnel-manager/keys/edge6.key
TM_GRE_ACK=no
