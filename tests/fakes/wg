#!/usr/bin/env bash
set -euo pipefail
ROOT="${TM_FAKE_ROOT:?}"
LOG="${ROOT}/wg.log"
mkdir -p -- "$ROOT"
printf '%s\n' "$*" >>"$LOG"

case "${1:-}" in
  genkey)
    printf '%s\n' "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="
    ;;
  pubkey)
    printf '%s\n' "BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB="
    ;;
  show)
    if [[ "${2:-}" == "interfaces" ]]; then
      if [[ -f "${ROOT}/wg.up" ]]; then
        cat "${ROOT}/wg.up"
      fi
      exit 0
    fi
    exit 0
    ;;
  *)
    exit 97
    ;;
esac
