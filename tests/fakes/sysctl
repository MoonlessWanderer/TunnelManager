#!/usr/bin/env bash
set -euo pipefail
ROOT="${TM_FAKE_ROOT:?}"
STATE="${ROOT}/sysctl.state"
LOG="${ROOT}/sysctl.log"
mkdir -p -- "$ROOT"
touch "$STATE"
printf '%s\n' "$*" >>"$LOG"

if [[ "${1:-}" == "-n" ]]; then
  key="${2:-}"
  value=$(awk -F '=' -v k="$key" '$1 == k { print $2 }' "$STATE" | tail -n 1)
  if [[ -z "$value" ]]; then
    if [[ "$key" == "net.ipv4.ip_forward" ]]; then
      printf '%s\n' "0"
      exit 0
    fi
    exit 1
  fi
  printf '%s\n' "$value"
  exit 0
fi

if [[ "${1:-}" == "-w" ]]; then
  pair="${2:-}"
  key=${pair%%=*}
  value=${pair#*=}
  grep -v "^${key}=" "$STATE" >"${STATE}.tmp" || true
  printf '%s=%s\n' "$key" "$value" >>"${STATE}.tmp"
  mv -f "${STATE}.tmp" "$STATE"
  exit 0
fi
exit 97
