#!/usr/bin/env bash
set -euo pipefail
ROOT="${TM_FAKE_ROOT:?}"
LOG="${ROOT}/haproxy.log"
mkdir -p -- "$ROOT"
printf '%s\n' "$*" >>"$LOG"

cfg=""
prev=""
for arg in "$@"; do
  if [[ "$prev" == "-f" ]]; then
    cfg="$arg"
  fi
  prev="$arg"
done

for arg in "$@"; do
  if [[ "$arg" == "-c" ]]; then
    [[ -f "$cfg" ]] || exit 1
    if [[ -f "${ROOT}/haproxy.reject-if" ]] && grep -q -F -- "$(tr -d '\r' <"${ROOT}/haproxy.reject-if")" "$cfg"; then
      exit 1
    fi
    grep -q "frontend " "$cfg" || exit 1
    exit 0
  fi
done

for arg in "$@"; do
  if [[ "$arg" == "-D" || "$arg" == "-Ws" ]]; then
    [[ -f "$cfg" ]] || exit 1
    pidfile=""
    prev=""
    for token in "$@"; do
      if [[ "$prev" == "-p" ]]; then
        pidfile="$token"
      fi
      prev="$token"
    done
    if [[ -n "$pidfile" ]]; then
      mkdir -p -- "$(dirname "$pidfile")"
      printf '%s\n' "4242" >"$pidfile"
    fi
    exit 0
  fi
done
exit 97
